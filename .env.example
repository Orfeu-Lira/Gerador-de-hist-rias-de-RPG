# Mesa — variáveis de servidor. NÃO coloque valores reais no GitHub.
NODE_ENV=production
FRONTEND_ORIGIN=https://orfeu-lira.github.io
# URL privada do Supabase Transaction Pooler, com senha URL-encoded.
DATABASE_URL=
# Gere valores aleatórios diferentes com 32+ caracteres.
SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
# Chave obtida no Google AI Studio; nunca expor no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
